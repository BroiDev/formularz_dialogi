<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#43C8FD"
            android:padding="12dp"
            android:text="@string/header"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />

        <LinearLayout
            android:id="@+id/rowQ1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLabelQ1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/question_1" />

            <TextView
                android:id="@+id/tvValueQ1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                tools:text="5" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbQ1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:min="1"
            android:max="10"
            android:progress="1" />

        <LinearLayout
            android:id="@+id/rowQ2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLabelQ2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/question_2" />

            <TextView
                android:id="@+id/tvValueQ2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                tools:text="5" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbQ2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="1"
            android:max="10"
            android:progress="1" />

        <TextView
            android:id="@+id/tvLabelQ3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/question_3" />

        <Spinner
            android:id="@+id/spQ3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvLabelQ4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/question_4" />

        <Spinner
            android:id="@+id/spQ4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvLabelQ5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/question_5" />

        <RadioGroup
            android:id="@+id/rgQ5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbQ5Yes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/question_5_yes" />

            <RadioButton
                android:id="@+id/rbQ5No"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/question_5_no" />

        </RadioGroup>

        <LinearLayout
            android:id="@+id/rowQ6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLabelQ6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/question_6" />

            <TextView
                android:id="@+id/tvValueQ6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                tools:text="3" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbQ6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="1"
            android:max="5"
            android:progress="1" />

        <LinearLayout
            android:id="@+id/rowQ7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLabelQ7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/question_7" />

            <TextView
                android:id="@+id/tvValueQ7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                tools:text="3" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbQ7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:min="1"
            android:max="5"
            android:progress="1" />

        <TextView
            android:id="@+id/tvLabelQ8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/question_8" />

        <EditText
            android:id="@+id/etQ8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_question_8"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swNewsletter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/newsletter" />

        <EditText
            android:id="@+id/etNewsletterEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_newsletter_email"
            android:inputType="textEmailAddress"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_submit" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_clear"
            style="?attr/materialButtonOutlinedStyle" />

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            tools:text="Podsumowanie wyników" />

    </LinearLayout>
</ScrollView>
